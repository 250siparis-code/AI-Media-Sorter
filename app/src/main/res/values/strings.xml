    <!-- Screen 1: Welcome / Home -->
    <string name="welcome_badge">OFFLINE ON-DEVICE PIPELINE</string>
    <string name="welcome_title">AI Media Sorter</string>
    <string name="welcome_description">Analyze photos and videos locally on-device, review classification results, and either export Termux-compatible shell scripts/manifests or organize files safely without cloud uploads.</string>
    <string name="feature_ai_title">On-Device Visual Classification</string>
    <string name="feature_ai_desc">Runs real ML Kit image labeling locally. Uncertain and diagnostic results require review; scores are not measured accuracy.</string>
    <string name="feature_folders_title">Termux Script &amp; Manifest Export</string>
    <string name="feature_folders_desc">Generates classification_report.csv, file_operations.json, move_files.sh, and copy_files.sh with dry-run defaults, SHA-256 checks, and POSIX escaping.</string>
    <string name="feature_preserve_title">Timestamp &amp; Byte-Exact Preservation</string>
    <string name="feature_preserve_desc">Copies unchanged media bytes and verifies SHA-256 readback. When modification time cannot be verified, the default policy keeps originals.</string>
